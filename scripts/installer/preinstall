#!/bin/bash
set -euo pipefail
volume="${3:-/}"
applications="${volume%/}/Applications"
app="$applications/KeySwitch.app"
# Validate the destination before stopping any running application.
if [[ -L "$applications" || -L "$app" ]]; then
    echo 'KeySwitch installation destination must not be a symbolic link.' >&2
    exit 1
fi
if [[ -e "$app" ]]; then
    identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null) || exit 1
    if [[ "$identifier" != local.keyswitch.app ]]; then
        echo 'An unrelated application occupies the KeySwitch installation path.' >&2
        exit 1
    fi
fi
# Alternate-volume installs must not stop the running system's application.
[[ "$volume" == / ]] || exit 0
# A failed process inventory must block replacement of a potentially running app.
processes=$(/bin/ps -axo pid=,comm=) || {
    echo 'Cannot check running applications. Installation was stopped.' >&2
    exit 1
}
pids=()
while read -r pid executable; do
    [[ "$executable" == */Contents/MacOS/KeySwitch ]] || continue
    bundle="${executable%/Contents/MacOS/KeySwitch}"
    [[ ! -L "$bundle" && -f "$bundle/Contents/Info.plist" ]] || continue
    identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$bundle/Contents/Info.plist" 2>/dev/null) || continue
    [[ "$identifier" == local.keyswitch.app ]] || continue
    kill -TERM "$pid" 2>/dev/null || true
    pids+=("$pid")
done <<< "$processes"
# Bash 3.2 treats an empty array as unset under nounset.
for pid in ${pids[@]+"${pids[@]}"}; do
    for attempt in {1..10}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo 'KeySwitch is still running. Quit it and run the installer again.' >&2
        exit 1
    fi
done
